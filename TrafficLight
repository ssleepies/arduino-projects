const int buttonPin = 2; // Pedestrian button
const int greenLed = 13;
const int yellowLed = 12;
const int redLed = 11;

void setup() {
  pinMode(greenLed, OUTPUT);
  pinMode(yellowLed, OUTPUT);
  pinMode(redLed, OUTPUT);
  pinMode(buttonPin, INPUT);
}

void loop() {
  // Normal traffic light sequence
  digitalWrite(greenLed, HIGH);
  digitalWrite(yellowLed, LOW);
  digitalWrite(redLed, LOW);
  delay(1000);

  digitalWrite(greenLed, LOW);
  digitalWrite(yellowLed, HIGH);
  delay(1000);

  digitalWrite(yellowLed, LOW);
  digitalWrite(redLed, HIGH);
  delay(2000);

  // Check if pedestrian button is pressed
  if (digitalRead(buttonPin) == HIGH) {
    // Flash yellow to indicate pedestrian crossing
    for (int i = 0; i < 5; i++) { // Flash 5 times
      digitalWrite(yellowLed, HIGH);
      delay(500);
      digitalWrite(yellowLed, LOW);
      delay(500);
    }
    // Return to normal sequence
    digitalWrite(redLed, LOW);
  }
}
